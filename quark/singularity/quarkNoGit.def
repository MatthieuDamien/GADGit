Bootstrap: docker
From: ubuntu:24.04

%help 
This is a singularity container to launch a React application named quark with yarn.
Includes: Node.js, yarn, React, Tailwind CSS, Lucide React, and offline support.
Author : matt.damien@icloud.com

%labels
    Author Matthieu Damien
    Version 0.1
    Description Application React avec yarn, Tailwind CSS, Lucide React et support offline
    Maintainer matt.damien@icloud.com
    NodeJS_version 20.x
    Yarn_version 1.22.x
    React_version 19.x

%setup
SINGULARITY_ROOTFS=$APPTAINER_ROOTFS

%post
# Mise à jour du système
apt-get update && apt-get upgrade -y





# Installation des dépendances système
apt-get install -y \
    curl \
    wget \
    gnupg2 \
    software-properties-common \
    build-essential \
    git \
    ca-certificates

# Installation de Node.js 20.x (version LTS recommandée)
curl -fsSL https://deb.nodesource.com/setup_20.x | bash -
apt-get install -y nodejs

# Installation de Yarn
curl -sS https://dl.yarnpkg.com/debian/pubkey.gpg | gpg --dearmor -o /usr/share/keyrings/yarnkey.gpg
echo "deb [signed-by=/usr/share/keyrings/yarnkey.gpg] https://dl.yarnpkg.com/debian stable main" | tee /etc/apt/sources.list.d/yarn.list
apt-get update && apt-get install -y yarn

# Création du répertoire de travail
mkdir -p /app
cd /app

# Initialisation d'un projet React avec create-react-app
npx create-react-app quark --template typescript

# Configuration de yarn offline
yarn config set yarn-offline-mirror ./yarn-offline-mirror
yarn config set yarn-offline-mirror-pruning true

# Installation des dépendances spécifiées
yarn add tailwindcss postcss autoprefixer
yarn add lucide-react
yarn add react-scripts

# Configuration de Tailwind CSS
npx tailwindcss init -p



# Variables d'environnement
echo "export NODE_ENV=production" >> $SINGULARITY_ENVIRONMENT
echo "export PATH=/usr/local/bin:\$PATH" >> $SINGULARITY_ENVIRONMENT
echo "export YARN_CACHE_FOLDER=/app/.yarn-cache" >> $SINGULARITY_ENVIRONMENT

# Création d'un fichier de configuration Tailwind personnalisé
cat > /app/tailwind.config.js << 'EOF'
/** @type {import('tailwindcss').Config} */
module.exports = {
  content: [
    "./src/**/*.{js,jsx,ts,tsx}",
    "./public/index.html",
  ],
  theme: {
    extend: {},
  },
  plugins: [],
}
EOF

# Ajout de Tailwind CSS au fichier CSS principal
cat > /app/src/index.css << 'EOF'
@tailwind base;
@tailwind components;
@tailwind utilities;
EOF

# Configuration du cache yarn
mkdir -p /app/.yarn-cache
yarn config set cache-folder /app/.yarn-cache

# Installation de toutes les dépendances en mode offline
yarn install --frozen-lockfile --offline || yarn install --frozen-lockfile

# Build de l'application pour la production
yarn build

# Nettoyage
apt-get autoremove -y
apt-get clean
rm -rf /var/lib/apt/lists/*
rm -rf /tmp/*
rm -rf /var/tmp/*

# Permissions
chmod -R 755 /app





%runscript
cd /app
echo "Démarrage de l'application React Quark..."
echo "Mode disponibles:"
echo "  - dev:   yarn start (développement)"
echo "  - build: yarn build (construction)"
echo "  - serve: npx serve -s build (servir la version build)"
echo ""
echo "Utilisation: singularity run container.sif [dev|build|serve]"
echo "    Par défaut : dev"
echo ""

case "$1" in
    "dev")
        echo "Démarrage en mode développement..."
        yarn start
        ;;
    "build") 
        echo "Construction de l'application..."
        yarn build
        ;;
    "serve")
        echo "Service de l'application construite..."
        npx serve -s build -p 3000
        ;;
    *)
        echo "Démarrage par défaut en mode développement..."
        yarn start
        ;;
esac

%test
echo "=== Tests de l'environnement ==="
echo "Version de Node.js:"
node --version
echo ""
echo "Version de npm:"
npm --version
echo ""
echo "Version de yarn:"
yarn --version
echo ""
echo "Vérification des dépendances React:"
cd /app
echo "Packages installés:"
yarn list --depth=0 | grep -E "(react|tailwind|lucide)"
echo ""
echo "Vérification de la configuration Tailwind:"
if [ -f "tailwind.config.js" ]; then
    echo "Configuration Tailwind trouvée"
else
    echo "Configuration Tailwind manquante"
fi
echo ""
echo "Vérification du build:"
if [ -d "build" ]; then
    echo "Répertoire build présent"
else
    echo "Répertoire build manquant"
fi

%environment
export NODE_ENV=production
export PATH=/usr/local/bin:$PATH
export YARN_CACHE_FOLDER=/app/.yarn-cache

%startscript
cd /app
yarn start