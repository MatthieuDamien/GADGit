Bootstrap: docker
From: ubuntu:24.04

%help 
This is a singularity container to launch a React application named quark with yarn.
Includes: Node.js, yarn, React, Tailwind CSS, and Lucide React.
Author : matt.damien@icloud.com

%labels
    Author Matthieu Damien
    Version 0.3
    Description Clean React application with yarn, Tailwind CSS, and Lucide React
    Maintainer matt.damien@icloud.com
    NodeJS_version 20.x
    Yarn_version 1.22.x
    React_version 18.x

%setup
SINGULARITY_ROOTFS=$APPTAINER_ROOTFS

%post
# Mise à jour du système
export DEBIAN_FRONTEND=noninteractive
apt-get update && apt-get upgrade -y

# Installation des dépendances système
apt-get install -y \
    curl \
    wget \
    gnupg2 \
    software-properties-common \
    build-essential \
    git \
    ca-certificates \
    python3 \
    python3-pip

# Installation de Node.js 20.x (version LTS)
curl -fsSL https://deb.nodesource.com/setup_20.x | bash -
apt-get install -y nodejs

# Installation de Yarn
curl -sS https://dl.yarnpkg.com/debian/pubkey.gpg | gpg --dearmor -o /usr/share/keyrings/yarnkey.gpg
echo "deb [signed-by=/usr/share/keyrings/yarnkey.gpg] https://dl.yarnpkg.com/debian stable main" | tee /etc/apt/sources.list.d/yarn.list
apt-get update && apt-get install -y yarn

# Création du répertoire de travail
mkdir -p /app
cd /app

# Configuration de yarn cache
mkdir -p /app/.yarn-cache
yarn config set cache-folder /app/.yarn-cache

# Initialisation du projet React
npx create-react-app quark

# Changement vers le répertoire de l'app
cd /app/quark

# Installation de Tailwind CSS et Lucide React
yarn add -D tailwindcss postcss autoprefixer
yarn add lucide-react

# Configuration de Tailwind CSS
npx tailwindcss init -p

# Configuration Tailwind propre
cat > /app/quark/tailwind.config.js << 'EOF'
/** @type {import('tailwindcss').Config} */
module.exports = {
  content: [
    "./src/**/*.{js,jsx,ts,tsx}",
    "./public/index.html",
  ],
  theme: {
    extend: {},
  },
  plugins: [],
}
EOF

# Ajout de Tailwind CSS au fichier CSS principal
cat > /app/quark/src/index.css << 'EOF'
@tailwind base;
@tailwind components;
@tailwind utilities;
EOF

# Installation finale des dépendances (déjà fait par create-react-app et yarn add)
echo "Dépendances installées avec succès"

# Variables d'environnement
echo "export NODE_ENV=development" >> $SINGULARITY_ENVIRONMENT
echo "export PATH=/usr/local/bin:\$PATH" >> $SINGULARITY_ENVIRONMENT
echo "export YARN_CACHE_FOLDER=/app/.yarn-cache" >> $SINGULARITY_ENVIRONMENT

# Nettoyage
apt-get autoremove -y
apt-get clean
rm -rf /var/lib/apt/lists/*
rm -rf /tmp/*
rm -rf /var/tmp/*

# Permissions
chmod -R 755 /app

%runscript
cd /app/quark
echo "=== Quark React Dashboard ==="
echo "Application prête à démarrer"
echo ""
echo "Commandes disponibles:"
echo "  dev     - Démarrage en mode développement (port 3000)"
echo "  build   - Construction pour production"
echo "  serve   - Service de la version production"
echo ""

case "$1" in
    "dev"|"")
        echo "Démarrage en mode développement..."
        yarn start
        ;;
    "build") 
        echo "Construction de l'application..."
        yarn build
        echo "Build terminé dans le dossier build/"
        ;;
    "serve")
        echo "Démarrage du serveur de production..."
        if [ ! -d "build" ]; then
            echo "  Dossier build introuvable, construction en cours..."
            yarn build
        fi
        npx serve -s build -p 3000
        ;;
    *)
        echo "Commande inconnue: $1"
        echo "Utilisez: dev, build, ou serve"
        ;;
esac

%test
echo "=== Tests de l'environnement ==="
echo "Version de Node.js: $(node --version)"
echo "Version de npm: $(npm --version)"
echo "Version de yarn: $(yarn --version)"
echo ""

cd /app/quark
echo "=== Vérification du projet ==="
if [ -f "package.json" ]; then
    echo "package.json trouvé"
else
    echo "package.json manquant"
fi

if [ -f "tailwind.config.js" ]; then
    echo "Configuration Tailwind OK"
else
    echo "Configuration Tailwind manquante"
fi

if [ -d "node_modules" ]; then
    echo "Dépendances installées"
else
    echo "Dépendances manquantes"
fi

echo ""
echo "=== Structure du projet ==="
ls -la src/ | head -10

%environment
export NODE_ENV=development
export PATH=/usr/local/bin:$PATH
export YARN_CACHE_FOLDER=/app/.yarn-cache
export PORT=3000

%startscript
cd /app/quark
yarn start