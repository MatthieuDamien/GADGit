MONGODB_URI=mongodb://localhost:27017/quark_db?replicaSet=rs0
PORT=5000

# Durée de vie des documents en secondes
# Pour le développement (ex: 5 minutes = 300 secondes)
SNAPSHOT_TTL_SECONDS=21600
SUMMARIES_TTL_SECONDS=21600
# Pour la production (ex: 24 heures = 86400 secondes)
# DATA_TTL_SECONDS=86400
